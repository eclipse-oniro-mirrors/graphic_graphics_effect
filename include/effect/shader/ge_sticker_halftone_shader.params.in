struct [[ge::params(type=STICKER_HALFTONE, name="StickerHalftone")]] GEStickerHalftoneShaderParams {
    std::shared_ptr<Drawing::Image> sticker_;
    [[ge::prop(min=3.0f)]]
    float gridSize_ = 0.0f;
    [[ge::prop(min=0.0f, max=1.0f)]]
    float maxRadiusRatio_ = 1.0f;
    [[ge::prop(min=0.0f)]]
    float lumCoeff_ = 0.0f;
    [[ge::prop(min=0.0f, max=1.0f)]]
    float colorWidthRatio_ = 0.5f;
    [[ge::prop(min=0.0f, max=1.0f)]]
    float saturation_ = 1.0f;
    [[ge::prop(min=0.0f)]]
    float smoothness_ = 0.0f;
    float angle_ = 0.0f;
    [[ge::prop(min=0.0f)]]
    float outlinePx_ = 0.0f;
    [[ge::prop(min=0.0f)]]
    float shadowDistance_ = 0.0f;
    Vector2f lightDir_ = Vector2f(0.0f, 0.0f);
    Vector4f elevationShadowColor_ = Vector4f(0.0f, 0.0f, 0.0f, 26.0f / 255.0f);
    [[ge::prop(min=0.0f)]]
    float elevationShadowRadius_ = 0.0f;
};
